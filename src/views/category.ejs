<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <section>
        <h2><%= categoryDetails.name %></h2>

        <h3>Service Projects in This Category</h3>

        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </li>
            <% }) %>
        </ul>
    </section>
</main>

<%- include('partials/footer') %>